# ==========================================
# Variáveis de Ambiente - Finanças Pessoais
# ==========================================
# Preencha as chaves no ambiente de implantação.
# NUNCA insira chaves reais ou segredos neste arquivo de exemplo.

# Gemini AI (injetado automaticamente pelo AI Studio)
GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# URL da Aplicação
APP_URL="https://seu-app.run.app"

# Firebase Client Configuration (Vite import.meta.env)
VITE_FIREBASE_API_KEY="SUA_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="seu-projeto.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="seu-projeto-id"
VITE_FIREBASE_STORAGE_BUCKET="seu-projeto.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="000000000000"
VITE_FIREBASE_APP_ID="1:000000000000:web:00000000000000"
VITE_FIREBASE_DATABASE_ID="ai-studio-finanaspessoais-default"
VITE_RECAPTCHA_SITE_KEY="SUA_CHAVE_RECAPTCHA_ENTERPRISE_AQUI"
